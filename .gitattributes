# Text files use LF everywhere, also in the working copy: Unity writes YAML assets with LF,
# so with CRLF checkouts (core.autocrlf=true) every Play left unchanged assets listed as modified.
* text=auto eol=lf

# Unity YAML (scenes, prefabs, assets, metadata)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf

# Code
*.cs text eol=lf diff=csharp

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
